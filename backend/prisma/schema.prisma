// CleanOps schema — Booking/Cleaning split version.
// This replaces the legacy joint CleaningEvent model.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── TENANT ───────────────────────────────────

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  settings  Json     @default("{}")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pmsProvider    String?
  pmsApiBaseUrl  String?
  pmsApiKey      String?
  pmsLastSyncAt  DateTime?
  pmsSyncEnabled Boolean   @default(true)

  /// Google Sheets id backing the Datasets module. Read-only; the sheet must
  /// be shared with the GCP_SERVICE_ACCOUNT_JSON service account as Viewer.
  datasetsSheetId String?

  users               User[]
  properties          Property[]
  bookings            Booking[]
  cleanings           Cleaning[]
  tags                ManagerTag[]
  notifications       Notification[]
  auditEvents         AuditEvent[]
  incidents           Incident[]
  manualStreamEvents  ManualStreamEvent[]
  repairs             Repair[]
  repairMaterials     RepairMaterial[]
  turnovers           Turnover[]
  notes               Note[]
  helpDocs            HelpDoc[]
  conversations       Conversation[]
  pmsSyncFailures     PmsSyncFailure[]
  cdmUsers            CdmUser[]
  cdmAccommodations   CdmAccommodation[]
  datasetFields       DatasetField[]
  datasetFieldRoles   DatasetFieldRole[]

  @@map("tenants")
}

// ─── USER ─────────────────────────────────────

/// Roles the portal knows about.
///
/// Only MANAGER, CLEANER and REPAIRMAN are wired to permissions today; the
/// rest exist so accounts can be created and addressed (a role is also an
/// audience for announcements) before we decide what each one may open.
/// Until then they behave like a user with no permissions — every endpoint
/// guarded by @Roles() refuses them, which is the safe default.
///
/// ADMIN is the exception: it satisfies every @Roles() check, so an admin
/// account cannot lock itself out of the app it administers.
enum UserRole {
  MANAGER
  CLEANER
  REPAIRMAN

  ADMIN
  OPERATION_MANAGER
  FRONT_DESK_MANAGER
  FRONT_DESK
  ASSIST
  /// Field runner — moves between flats with linen, keys and small fixes.
  /// Scope still to be defined.
  TERENAK
  AGENT

  /// Added 30 Aug 2026. Values only — no module access is granted to any of
  /// these yet, and under the default-deny matrix that is the safe state:
  /// a role with no grants sees nothing rather than everything.
  DIRECTOR
  EVIDENCE
  RESOLUTIONS
  MARKETING_MANAGER
}

enum Language {
  en
  cs
  ru
  uk
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  email     String
  name      String
  role      UserRole
  language  Language  @default(en)
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  cdmUserId       String?   @unique
  position        String?
  isSyncManaged   Boolean   @default(true)
  lastSyncedAt    DateTime?
  disabledAt      DateTime?

  mobileNumber     String?

  passwordHash     String?
  emailVerifiedAt  DateTime?
  magicLinkToken   String?   @unique
  magicLinkExpiry  DateTime?
  lastLoginAt      DateTime?

  preferences      Json      @default("{}")
  pushSubscription Json?

  tenant               Tenant               @relation(fields: [tenantId], references: [id])
  assignedCleanings    CleaningAssignment[] @relation("AssignedCleaner")
  createdAssignments   CleaningAssignment[] @relation("AssignedBy")
  defaultProperties    Property[]           @relation("DefaultCleaner")
  notifications        Notification[]
  sessions             Session[]
  auditEvents          AuditEvent[]
  reportedIncidents    Incident[]           @relation("IncidentReporter")
  assignedIncidents    Incident[]           @relation("IncidentAssignee")
  resolvedIncidents    Incident[]           @relation("IncidentResolver")
  uploadedAttachments  IncidentAttachment[] @relation("AttachmentUploader")
  manualStreamEvents   ManualStreamEvent[]

  assignedRepairs          RepairAssignment[] @relation("AssignedRepairman")
  createdRepairAssignments RepairAssignment[] @relation("RepairAssignedBy")
  uploadedRepairPhotos     RepairPhoto[]      @relation("RepairPhotoUploader")
  repairComments           RepairComment[]    @relation("RepairCommentAuthor")
  repairReports            RepairReport[]     @relation("RepairReportAuthor")

  assignedTurnovers          TurnoverAssignment[]  @relation("AssignedTurnover")
  createdTurnoverAssignments TurnoverAssignment[]  @relation("TurnoverAssignedBy")

  authoredNotes              Note[]                @relation("NoteAuthor")
  publishedHelpDocs          HelpDoc[]             @relation("HelpDocPublisher")
  createdConversations       Conversation[]        @relation("ConversationCreator")
  conversationMemberships    ConversationMember[]  @relation("ConversationMemberUser")
  addedConversationMembers   ConversationMember[]  @relation("ConversationMemberAddedBy")
  conversationMessages       ConversationMessage[] @relation("ConversationMessageAuthor")
  noteTargets                NoteTarget[]
  noteAcks                   NoteAck[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@index([tenantId, isActive])
  @@index([cdmUserId])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  token        String   @unique
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

// ─── PROPERTY ─────────────────────────────────

model Property {
  id              String   @id @default(uuid())
  tenantId        String
  name            String
  address         String?
  locationLat     Float?
  locationLng     Float?
  defaultCleanerId String?
  pmsPropertyId   String?

  accommodationType String?
  pmsStatus         String?
  pmsClean          Boolean  @default(false)
  pmsLastSyncedAt   DateTime?

  notes           String?
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  defaultCleaner      User?               @relation("DefaultCleaner", fields: [defaultCleanerId], references: [id])
  bookings            Booking[]
  cleanings           Cleaning[]
  incidents           Incident[]
  manualStreamEvents  ManualStreamEvent[]
  repairs             Repair[]
  turnovers           Turnover[]
  noteTargets         NoteTarget[]

  @@unique([tenantId, pmsPropertyId])
  @@index([tenantId])
  @@index([tenantId, pmsStatus])
  @@map("properties")
}

// ─── ENUMS for Booking + Cleaning ─────────────

enum CleaningStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  FLAGGED
}

enum CleaningType {
  CHECKOUT
  MIDSTAY
  DEEP
}

enum BookingChannel {
  AIRBNB
  BOOKING_COM
  VRBO
  EXPEDIA
  DIRECT
  OTHER
}

/// Where a check-in / check-out time came from.
///
/// The distinction matters because "15:00 because the guest said so" and
/// "15:00 because nobody said anything" look identical in a timestamp column —
/// and only one of them is worth putting in front of a manager to confirm.
///
/// MANAGER outranks everything: once a human has set a time, no sync may
/// replace it with a guess, even if the PMS keeps sending midnight.
enum TimeSource {
  /// A real time from the PMS.
  PMS
  /// The PMS said nothing, or said midnight; we filled in the house default.
  FALLBACK
  /// A manager set it in Planning and pushed it to the PMS.
  MANAGER
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

// ─── BOOKING ──────────────────────────────────

model Booking {
  id                String         @id @default(uuid())
  tenantId          String
  propertyId        String
  isOwnerStay       Boolean        @default(false)


  // PMS identity & ref
  bookingRef        String
  pmsBookingId      String?
  status            BookingStatus  @default(CONFIRMED)
  cancelledAt       DateTime?

  // Reservation details
  checkInTime       DateTime
  checkInSource     TimeSource     @default(PMS)
  checkOutTime      DateTime?
  checkOutSource    TimeSource     @default(PMS)
  accommodationName String
  accommodationType String?
  numAdults         Int            @default(1)
  numChildren       Int            @default(0)
  channel           BookingChannel @default(OTHER)

  // PMS sync
  pmsLastSyncedAt   DateTime?
  pmsRawData        Json?

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tenant            Tenant         @relation(fields: [tenantId], references: [id])
  property          Property       @relation(fields: [propertyId], references: [id])
  cleaning          Cleaning?      // 1:1 (a booking has at most one cleaning)
  turnoversAsFrom   Turnover[]            @relation("TurnoverFromBooking")
  turnoversAsTo     Turnover[]            @relation("TurnoverToBooking")
  incidents         Incident[]

  @@unique([tenantId, pmsBookingId])
  @@index([tenantId])
  @@index([tenantId, checkInTime])
  @@index([propertyId])
  @@index([bookingRef])
  @@map("bookings")
}

// ─── CLEANING ─────────────────────────────────

model Cleaning {
  id                String         @id @default(uuid())
  tenantId          String
  propertyId        String
  isOwnerStay       Boolean        @default(false)


  // 1:1 with Booking (cleaning is derived from booking)
  bookingId         String         @unique

  // Core cleaning fields
  cleaningType      CleaningType   @default(CHECKOUT)
  status            CleaningStatus @default(PENDING)
  timeSlot          DateTime
  maxCleaners       Int            @default(1)

  managerNote       String?
  cleanerNote       String?
  supplyNote        String?

  startedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?

  // ─── Denormalized booking fields (kept in sync by booking-sync.service) ───
  // These mirror Booking columns so cleaning queries don't need a join for the
  // most common views (mine, pool, planning, schedule).
  bookingRef        String
  checkInTime       DateTime
  checkOutTime      DateTime?
  accommodationName String
  numAdults         Int            @default(1)
  numChildren       Int            @default(0)
  channel           BookingChannel @default(OTHER)
  pmsLastSyncedAt   DateTime?

  // Cleaning continues even if booking is cancelled — but UI shows the flag.
  bookingCancelledAt DateTime?

  // Previous guest's checkout at the same property (denormalized; reconciled by sync)
  previousGuestCheckOutTime DateTime?

  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  tenant            Tenant               @relation(fields: [tenantId], references: [id])
  property          Property             @relation(fields: [propertyId], references: [id])
  booking           Booking              @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  assignments       CleaningAssignment[]
  photos            CleaningPhoto[]
  tags              CleaningTag[]
  incidents         Incident[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, timeSlot])
  @@index([tenantId, checkInTime])
  @@index([propertyId])
  @@map("cleanings")
}

// ─── CLEANING ASSIGNMENT ──────────────────────

enum AssignmentStatus {
  ASSIGNED
  STARTED
  COMPLETED
  REJECTED
  REASSIGNED
}

model CleaningAssignment {
  id               String           @id @default(uuid())
  cleaningId       String
  userId           String
  assignedById     String?
  isPrimary        Boolean          @default(false)
  status           AssignmentStatus @default(ASSIGNED)

  rejectedReason   String?
  startedAt        DateTime?
  completedAt      DateTime?
  assignedAt       DateTime         @default(now())

  cleaning         Cleaning         @relation(fields: [cleaningId], references: [id], onDelete: Cascade)
  user             User             @relation("AssignedCleaner", fields: [userId], references: [id])
  assignedBy       User?            @relation("AssignedBy", fields: [assignedById], references: [id])
  photos           CleaningPhoto[]

  @@index([cleaningId])
  @@index([userId])
  @@index([userId, status])
  @@map("cleaning_assignments")
}

// ─── CLEANING PHOTOS ──────────────────────────

model CleaningPhoto {
  id                    String              @id @default(uuid())
  cleaningId            String
  cleaningAssignmentId  String?
  url                   String
  caption               String?
  uploadedAt            DateTime            @default(now())

  cleaning              Cleaning            @relation(fields: [cleaningId], references: [id], onDelete: Cascade)
  cleaningAssignment    CleaningAssignment? @relation(fields: [cleaningAssignmentId], references: [id])

  @@index([cleaningId])
  @@map("cleaning_photos")
}

// ─── MANAGER TAGS ─────────────────────────────

model ManagerTag {
  id        String   @id @default(uuid())
  tenantId  String
  label     String
  color     String   @default("#6b7280")
  createdAt DateTime @default(now())

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  cleanings CleaningTag[]

  @@unique([tenantId, label])
  @@index([tenantId])
  @@map("manager_tags")
}

model CleaningTag {
  id          String     @id @default(uuid())
  cleaningId  String
  tagId       String
  createdAt   DateTime   @default(now())

  cleaning    Cleaning   @relation(fields: [cleaningId], references: [id], onDelete: Cascade)
  tag         ManagerTag @relation(fields: [tagId], references: [id])

  @@unique([cleaningId, tagId])
  @@map("cleaning_tags")
}

// ─── NOTIFICATIONS ────────────────────────────

enum NotificationType {
  NEW_ASSIGNMENT
  REASSIGNMENT
  CANCELLATION
  BOOKING_MODIFIED
  REMINDER
  OVERDUE
  INCIDENT_UPDATE
}

enum NotificationChannel {
  PUSH
  EMAIL
  IN_APP
}

model Notification {
  id        String              @id @default(uuid())
  tenantId  String
  userId    String
  type      NotificationType
  channel   NotificationChannel
  title     String
  body      String
  payload   Json                @default("{}")
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime            @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@index([tenantId, createdAt])
  @@map("notifications")
}

// ─── AUDIT ────────────────────────────────────

enum AuditCategory {
  CLEANING_LIFECYCLE
  ASSIGNMENT_LIFECYCLE
  AUTH
  PMS_SYNC
  INCIDENT_LIFECYCLE
  SYSTEM
  /// Someone changed a row in a CDM dataset through the app.
  DATA_EDIT
}

model AuditEvent {
  id          String        @id @default(uuid())
  tenantId    String
  category    AuditCategory
  action      String
  actorId     String?
  actorEmail  String?
  targetType  String?
  targetId    String?
  metadata    Json?
  createdAt   DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  actor  User?  @relation(fields: [actorId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, category, createdAt])
  @@map("audit_events")
}

// ─── INCIDENT ─────────────────────────────────

enum IncidentType {
  CLEANING
  BOILER_INSPECTION
  ACCIDENT
  PHOTO_SHOOT
  REPAIR
  GENERAL
}

enum IncidentStatus {
  OPEN
  SCHEDULED
  RESOLVED
  CLOSED
}

enum IncidentPriority {
  LOW
  MEDIUM
  HIGH
}

model Incident {
  id              String           @id @default(uuid())
  tenantId        String

  type            IncidentType     @default(CLEANING)
  status          IncidentStatus   @default(OPEN)
  priority        IncidentPriority @default(MEDIUM)

  // Context — incident can link to a booking, a cleaning, neither, or both.
  // "isGeneral=true" overrides; otherwise propertyId/bookingId/cleaningId give
  // increasingly specific context.
  propertyId      String?
  isGeneral       Boolean          @default(false)
  bookingId       String?
  cleaningId      String?

  title           String
  description     String?

  reportedById    String?
  assignedToId    String?
  resolvedById    String?

  scheduledFor    DateTime?
  resolvedAt      DateTime?
  resolutionNote  String?

  pmsBlockId      String?
  guestNotifiedAt DateTime?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant       Tenant                @relation(fields: [tenantId], references: [id])
  property     Property?             @relation(fields: [propertyId], references: [id])
  booking      Booking?              @relation(fields: [bookingId],  references: [id])
  cleaning     Cleaning?             @relation(fields: [cleaningId], references: [id])
  reportedBy   User?                 @relation("IncidentReporter", fields: [reportedById], references: [id])
  assignedTo   User?                 @relation("IncidentAssignee", fields: [assignedToId], references: [id])
  resolvedBy   User?                 @relation("IncidentResolver", fields: [resolvedById], references: [id])
  attachments  IncidentAttachment[]
  repair       Repair?               @relation("RepairFromIncident")

  @@index([tenantId, status, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId, type, createdAt])
  @@index([propertyId])
  @@index([bookingId])
  @@index([cleaningId])
  @@index([assignedToId])
  @@index([reportedById])
  @@map("incidents")
}

model IncidentAttachment {
  id           String   @id @default(uuid())
  incidentId   String
  url          String
  mimeType     String?
  uploadedById String?
  createdAt    DateTime @default(now())

  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation("AttachmentUploader", fields: [uploadedById], references: [id])

  @@index([incidentId])
  @@map("incident_attachments")
}

// ─── MANUAL STREAM EVENTS (Phase D-1) ─────────

enum StreamEventCategory {
  MANUAL
  NOTE
  REPAIR
  INSPECTION
}

model ManualStreamEvent {
  id           String              @id @default(uuid())
  tenantId     String
  propertyId   String?
  authorId     String

  category     StreamEventCategory @default(MANUAL)
  title        String
  description  String?

  photoUrls    String[]            @default([])
  occurredAt   DateTime            @default(now())

  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  property     Property?           @relation(fields: [propertyId], references: [id])
  author       User                @relation(fields: [authorId], references: [id])

  @@index([tenantId, occurredAt])
  @@index([tenantId, propertyId, occurredAt])
  @@index([tenantId, category, occurredAt])
  @@map("manual_stream_events")
}

// ─── REPAIRS (Phase R-1) ──────────────────────

enum RepairStatus {
  PLANNED         // created, not yet assigned
  ASSIGNED        // repairman assigned, not yet started
  IN_PROGRESS     // repairman tapped Start
  IN_REVIEW       // repairman submitted Done; awaiting manager approval
  DONE            // manager confirmed completion
  REPORTED_BACK   // repairman reported a problem; assigned back to manager
  CANCELLED
}

enum RepairAssignmentStatus {
  ASSIGNED
  STARTED
  COMPLETED
  REJECTED
  REASSIGNED
}

enum RepairAuthorRole {
  MANAGER
  REPAIRMAN
  SYSTEM
}

enum RepairReportUrgency {
  LOW
  AVERAGE
  HIGH
}

model Repair {
  id           String        @id @default(uuid())
  tenantId     String
  propertyId   String

  // Optional link back to the incident this repair originated from
  incidentId   String?       @unique

  status       RepairStatus  @default(PLANNED)
  title        String
  description  String?       // up to 300 chars (controller-level validation)
  dueDate      DateTime      // REQUIRED — manager sets

  // Lifecycle timestamps
  startedAt    DateTime?
  completedAt  DateTime?     // when repairman submitted Done (status → IN_REVIEW)
  reviewedAt   DateTime?     // when manager confirmed DONE
  reportedAt   DateTime?     // when repairman tapped Report a problem
  cancelledAt  DateTime?

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  property     Property      @relation(fields: [propertyId], references: [id])
  incident     Incident?     @relation("RepairFromIncident", fields: [incidentId], references: [id])
  assignments  RepairAssignment[]
  materials    RepairMaterialUsage[]
  photos       RepairPhoto[]
  comments     RepairComment[]
  reports      RepairReport[]

  @@index([tenantId, status, dueDate])
  @@index([tenantId, dueDate])
  @@index([propertyId])
  @@map("repairs")
}

model RepairAssignment {
  id               String                  @id @default(uuid())
  repairId         String
  userId           String
  assignedById     String?
  isPrimary        Boolean                 @default(false)
  status           RepairAssignmentStatus  @default(ASSIGNED)
  rejectedReason   String?
  startedAt        DateTime?
  completedAt      DateTime?
  assignedAt       DateTime                @default(now())

  repair           Repair                  @relation(fields: [repairId], references: [id], onDelete: Cascade)
  user             User                    @relation("AssignedRepairman", fields: [userId], references: [id])
  assignedBy       User?                   @relation("RepairAssignedBy", fields: [assignedById], references: [id])

  @@index([repairId])
  @@index([userId])
  @@index([userId, status])
  @@map("repair_assignments")
}

// Manager-configured material catalog (predefined picklist)
model RepairMaterial {
  id        String                @id @default(uuid())
  tenantId  String
  name      String                // e.g. "Baterie", "Kabely"
  unit      String?               // optional unit (e.g. "ks", "m", "kg")
  isActive  Boolean               @default(true)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  tenant    Tenant                @relation(fields: [tenantId], references: [id])
  usages    RepairMaterialUsage[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("repair_materials")
}

// Per-repair material usage row (created when repairman submits Done)
model RepairMaterialUsage {
  id          String          @id @default(uuid())
  repairId    String
  materialId  String
  amount      Float           // quantity used
  note        String?         // optional inline note
  createdAt   DateTime        @default(now())

  repair      Repair          @relation(fields: [repairId], references: [id], onDelete: Cascade)
  material    RepairMaterial  @relation(fields: [materialId], references: [id])

  @@index([repairId])
  @@map("repair_material_usages")
}

model RepairPhoto {
  id            String    @id @default(uuid())
  repairId      String
  url           String    // GCS publicUrl
  caption       String?
  uploadedById  String?
  uploadedAt    DateTime  @default(now())

  repair        Repair    @relation(fields: [repairId], references: [id], onDelete: Cascade)
  uploadedBy    User?     @relation("RepairPhotoUploader", fields: [uploadedById], references: [id])

  @@index([repairId])
  @@map("repair_photos")
}

model RepairComment {
  id          String              @id @default(uuid())
  repairId    String
  authorId    String
  authorRole  RepairAuthorRole    @default(MANAGER)
  body        String
  createdAt   DateTime            @default(now())

  repair      Repair              @relation(fields: [repairId], references: [id], onDelete: Cascade)
  author      User                @relation("RepairCommentAuthor", fields: [authorId], references: [id])

  @@index([repairId, createdAt])
  @@map("repair_comments")
}

// "Report a problem" — created when repairman taps Report instead of Done
model RepairReport {
  id          String                @id @default(uuid())
  repairId    String
  authorId    String                // repairman who reported
  urgency     RepairReportUrgency
  description String                // required, max ~500 chars
  photoUrls   String[]              @default([])
  resolvedAt  DateTime?             // when manager addressed it
  createdAt   DateTime              @default(now())

  repair      Repair                @relation(fields: [repairId], references: [id], onDelete: Cascade)
  author      User                  @relation("RepairReportAuthor", fields: [authorId], references: [id])

  @@index([repairId, createdAt])
  @@map("repair_reports")
}

// ─── TURNOVER (Phase 1 — additive, alongside Cleaning) ──────

enum TurnoverStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  FLAGGED
  CANCELLED
  SKIPPED
}

model Turnover {
  id              String           @id @default(uuid())
  tenantId        String
  propertyId      String

  fromBookingId   String?
  toBookingId     String?

  availableFrom   DateTime?
  dueBy           DateTime?

  status          TurnoverStatus   @default(PENDING)
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?

  completedAllGood Boolean?

  maxCleaners      Int             @default(1)
  managerNote      String?
  cleanerNote      String?
  supplyNote       String?
  isOwnerStay      Boolean         @default(false)

  // Why this turnover was SKIPPED. Lets the reconciler tell a system-merged
  // slot (safe to re-thread) apart from a deliberate human skip (never touch).
  // Values: 'MERGED_ON_CANCELLATION' | 'MANAGER_SKIPPED'
  skipReason       String?

  supersededById   String?         
  supersededBy     Turnover?       @relation("TurnoverSupersession", fields: [supersededById], references: [id])
  supersedes       Turnover[]       @relation("TurnoverSupersession")

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  property         Property        @relation(fields: [propertyId], references: [id])
  fromBooking      Booking?        @relation("TurnoverFromBooking", fields: [fromBookingId], references: [id])
  toBooking        Booking?        @relation("TurnoverToBooking",   fields: [toBookingId],   references: [id])
  assignments      TurnoverAssignment[]
  photos           TurnoverPhoto[]

  conversations       Conversation[]

  @@index([tenantId, propertyId, availableFrom])
  @@index([tenantId, status, dueBy])
  @@index([tenantId, status])
  @@index([toBookingId])
  @@index([fromBookingId])
  @@index([supersededById])
  @@map("turnovers")
}

model TurnoverAssignment {
  id               String            @id @default(uuid())
  turnoverId       String
  userId           String
  assignedById     String?

  isPrimary        Boolean           @default(false)
  status           AssignmentStatus  @default(ASSIGNED)

  rejectedReason   String?
  startedAt        DateTime?
  completedAt      DateTime?
  assignedAt       DateTime          @default(now())

  turnover         Turnover          @relation(fields: [turnoverId],   references: [id], onDelete: Cascade)
  user             User              @relation("AssignedTurnover",    fields: [userId],       references: [id])
  assignedBy       User?             @relation("TurnoverAssignedBy",  fields: [assignedById], references: [id])
  photos           TurnoverPhoto[]

  @@index([turnoverId])
  @@index([userId])
  @@index([userId, status])
  @@map("turnover_assignments")
}

/// Photo evidence attached to a turnover, uploaded straight to GCS via a signed
/// URL; only the public URL is stored. Mirrors CleaningPhoto, which it replaces.
model TurnoverPhoto {
  id                    String              @id @default(uuid())
  turnoverId            String
  turnoverAssignmentId  String?
  url                   String
  caption               String?
  uploadedAt            DateTime            @default(now())

  turnover              Turnover            @relation(fields: [turnoverId], references: [id], onDelete: Cascade)
  turnoverAssignment    TurnoverAssignment? @relation(fields: [turnoverAssignmentId], references: [id])

  @@index([turnoverId])
  @@map("turnover_photos")
}

// ─────────────────────────────────────────────────────────────────────────────
// Manager messages ("Zpráva od manažera")
//
// A short broadcast a manager pushes to the cleaning team. It is NOT a note on
// a single cleaning (that stays `Turnover.managerNote`) and NOT a standing fact
// about a unit (that stays `Property.notes`). It has to be acknowledged.
//
// Targeting is exclusive: a message goes either to named people (STAFF) or to
// properties (PROPERTY) — never both. Enforced by a CHECK constraint on
// note_targets, not just by the UI.
//
// For PROPERTY messages the recipient set is resolved CONTINUOUSLY, not frozen
// at send time: whoever holds an active turnover on that property, plus the
// property's default cleaner, plus anyone who claims a turnover there while the
// message is still valid.
// ─────────────────────────────────────────────────────────────────────────────

enum NoteTargetType {
  STAFF
  PROPERTY
}

model Note {
  id         String         @id @default(uuid())
  tenantId   String
  authorId   String
  targetType NoteTargetType

  title      String
  /// Czech is the source text and is always required. The other three are
  /// optional translations; the reader falls back to Czech when missing.
  bodyCs     String
  bodyEn     String?
  bodyRu     String?
  bodyUk     String?

  validFrom  DateTime       @default(now())
  /// Mandatory. Without an end date messages pile up and get tapped away unread.
  validUntil DateTime

  /// Bumped whenever title/body changes — invalidates existing acknowledgements.
  version    Int            @default(1)
  isArchived Boolean        @default(false)

  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  tenant  Tenant       @relation(fields: [tenantId], references: [id])
  author  User         @relation("NoteAuthor", fields: [authorId], references: [id])
  targets NoteTarget[]
  acks    NoteAck[]

  @@index([tenantId, isArchived, validUntil])
  @@map("notes")
}

model NoteTarget {
  id         String  @id @default(uuid())
  noteId     String
  userId     String?
  propertyId String?

  note     Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  // Cascade, ne výchozí SetNull: prázdný cíl by porušil CHECK „právě jeden cíl“.
  user     User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId])
  @@unique([noteId, propertyId])
  @@index([userId])
  @@index([propertyId])
  @@map("note_targets")
}

model NoteAck {
  id          String   @id @default(uuid())
  noteId      String
  userId      String
  /// Version acknowledged. An edited message (version + 1) comes back.
  version     Int
  /// Which language the cleaner actually saw when confirming.
  localeShown String?
  ackedAt     DateTime @default(now())

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noteId, userId, version])
  @@index([userId])
  @@map("note_acks")
}

// ─────────────────────────────────────────────────────────────────────────────
// In-app manual ("Nápověda")
//
// One row per language. The content lives in the database rather than in the
// repo so the manual can be updated without shipping a release — the manager
// uploads the exported HTML and cleaners see it on their next open.
//
// `html` is a complete, self-contained document (its own <style>), because the
// app renders it in an iframe. That isolation is the point: the manual's CSS
// styles `body`, `h2`, `table` — injected into the page it would repaint the
// whole app.
// ─────────────────────────────────────────────────────────────────────────────

model HelpDoc {
  id            String   @id @default(uuid())
  tenantId      String
  /// cs | en | ru | uk — Czech is the fallback for anything missing.
  locale        String
  title         String?
  html          String
  /// Bumped on every publish; drives the "new manual" dot in the app.
  version       Int      @default(1)
  publishedAt   DateTime @default(now())
  publishedById String?
  updatedAt     DateTime @updatedAt

  tenant      Tenant @relation(fields: [tenantId], references: [id])
  publishedBy User?  @relation("HelpDocPublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, locale])
  @@index([tenantId])
  @@map("help_docs")
}

// ─────────────────────────────────────────────────────────────────────────────
// Conversations — the open channel on a turnover
//
// The counterpart to Note, which is closed: an announcement goes down and comes
// back only as a confirmation. A Conversation is two-way and belongs to a piece
// of work, not to a pair of phone numbers — which is the whole reason for
// moving this off WhatsApp. In six months "what happened at Černá on the 17th"
// has an answer.
//
// A cleaner may open one only on a turnover they hold AND have started; before
// that there is nothing concrete to talk about and the pool would fill with
// speculative threads. Managers may open one at any time.
// ─────────────────────────────────────────────────────────────────────────────

enum ConversationStatus {
  OPEN
  CLOSED
}

/// Two different animals that happen to share a message list.
///
/// TURNOVER — opened by whoever is doing the work, always about one cleaning.
///   It is part of that turnover's record, which is why the Stream shows it on
///   the turnover rather than as a line of its own.
/// DIRECT — opened by the office towards people. Not tied to a cleaning, so it
///   stands alone and only a manager can start one.
enum ChatKind {
  TURNOVER
  DIRECT
}

enum MessageKind {
  TEXT
  /// "X added Y", "cleaning finished" — written by the server, not a person.
  SYSTEM
}

enum AttachmentKind {
  IMAGE
  /// Not accepted yet; here so adding video later is a value, not a migration.
  VIDEO
}

model Conversation {
  id            String             @id @default(uuid())
  tenantId      String
  kind          ChatKind           @default(TURNOVER)
  /// Null for DIRECT chats — they belong to people, not to a cleaning.
  turnoverId    String?
  /// Subject line. Only DIRECT chats need one; a turnover chat is named by
  /// the flat it is about.
  title         String?
  createdById   String
  status        ConversationStatus @default(OPEN)
  /// Denormalised for ordering the list without touching every message.
  lastMessageAt DateTime?
  /// Set once the work is long finished and nobody kept the thread. Archived
  /// chats leave the inbox; they are still readable and still queryable.
  archivedAt    DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  tenant    Tenant                @relation(fields: [tenantId], references: [id])
  turnover  Turnover?            @relation(fields: [turnoverId], references: [id], onDelete: Cascade)
  createdBy User                  @relation("ConversationCreator", fields: [createdById], references: [id])
  members   ConversationMember[]
  messages  ConversationMessage[]

  @@index([tenantId, lastMessageAt])
  @@index([turnoverId])
  @@index([tenantId, kind])
  @@index([archivedAt])
  @@map("turnover_chats")
}

model ConversationMember {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  addedById      String?
  addedAt        DateTime  @default(now())
  leftAt         DateTime?
  /// Everything after this timestamp is unread for this person. One row per
  /// member is enough to compute badges; per-message receipts can come later.
  lastReadAt     DateTime?
  /// Kept by this person. A starred chat survives the 30-day archive sweep;
  /// unstar it and the next sweep takes it like any other.
  starred        Boolean   @default(false)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation("ConversationMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  addedBy      User?        @relation("ConversationMemberAddedBy", fields: [addedById], references: [id], onDelete: SetNull)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("turnover_chat_members")
}

model ConversationMessage {
  id             String      @id @default(uuid())
  conversationId String
  /// Null for SYSTEM messages.
  authorId       String?
  kind           MessageKind @default(TEXT)
  body           String?
  createdAt      DateTime    @default(now())
  editedAt       DateTime?

  conversation Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?               @relation("ConversationMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  attachments  MessageAttachment[]

  @@index([conversationId, createdAt])
  @@map("turnover_chat_messages")
}

model MessageAttachment {
  id        String         @id @default(uuid())
  messageId String
  kind      AttachmentKind @default(IMAGE)
  /// Canonical GCS object URL, same shape the incident photos use, so the
  /// existing SignedImage component renders it without changes.
  url       String
  mimeType  String?
  bytes     Int?
  width     Int?
  height    Int?
  createdAt DateTime       @default(now())

  message ConversationMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("turnover_chat_attachments")
}

/// One Avantio booking the sync could not fetch or process.
///
/// WHY THIS EXISTS
/// ---------------
/// The sync had no memory of a failure. A rejected `GET /bookings/{id}` was
/// logged with `logger.warn` and dropped, while `tenant.pmsLastSyncAt` still
/// advanced past it — so that booking was never asked for again. 19 bookings
/// were found missing this way on 22 Aug 2026, three of them cleanings whose
/// arrival had already passed.
///
/// A row here means "ask Avantio for this one again next run". It is deleted
/// the moment the booking syncs successfully.
model PmsSyncFailure {
  id            String   @id @default(uuid())
  tenantId      String
  /// Avantio booking id, as it appears in `GET /bookings/{id}`.
  pmsBookingId  String
  /// How many runs have tried and failed. Retries stop past a cap so one
  /// permanently broken booking cannot stall the queue forever.
  attempts      Int      @default(1)
  lastError     String
  firstFailedAt DateTime @default(now())
  lastFailedAt  DateTime @updatedAt

  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, pmsBookingId])
  @@index([tenantId])
  @@map("pms_sync_failures")
}

// ─── CDM DATASETS ─────────────────────────────────────────────
//
// The CDM spreadsheet, moving into Postgres one list at a time. Each list gets
// a real table; `DatasetField` describes it.
//
// That metadata table is the part that earns its keep. In the sheet era three
// separate mechanisms did this job badly: a `mapping<Tab>` sibling sheet found
// by fuzzy name matching (because `Accomodation` and `mappingAccommodation`
// disagree on how many m's), a hardcoded HIDDEN_BY_DEFAULT array that needed a
// deploy to change, and column order implied by position. All three collapse
// into rows here, and two whole classes of bug go with them: a table cannot
// have two columns called `status`, and a foreign key cannot be misspelled.

model DatasetField {
  id              String  @id @default(uuid())
  tenantId        String
  /// Which list this describes — matches the dataset key in the API.
  dataset         String
  /// 1-based position, from the mapping sheet's A/B/C column letters.
  columnOrder     Int
  /// The column name on the data table. Also the API's stable column key.
  field           String
  displayName     String
  description     String?
  /// text | int | bool | date. Drives both rendering and create-form parsing.
  type            String  @default("text")
  /// Tidiness: off in the default view, one click from being shown.
  hiddenByDefault Boolean @default(false)
  /// Permission: credentials and personal data. Never the same thing as
  /// hiddenByDefault, and never collapsed into it.
  sensitive       Boolean @default(false)
  /// Must be present when creating a row.
  required        Boolean @default(false)
  /// Which family of columns this belongs to — pricing, ota, credentials…
  /// Purely visual: the viewer tints each family so a 164-column table can be
  /// navigated sideways without counting headers.
  group           String?

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  overrides DatasetFieldRole[]

  @@unique([tenantId, dataset, field])
  @@index([tenantId, dataset, columnOrder])
  @@map("dataset_fields")
}

/// Per-role overrides on a dataset's columns.
///
/// Sparse by design: a role with no rows here gets the base order from
/// `dataset_fields`, and a row exists only for a column that role wants
/// somewhere else or out of the way. Storing a full ordering per role would be
/// 164 rows × every role, which nobody would keep correct for a week.
///
/// Note what this is NOT. It cannot reveal a column — a `sensitive` column
/// stays hidden from a role that may not read it no matter what this table
/// says. Ordering and tidiness only; permission stays in one place.
model DatasetFieldRole {
  id          String   @id @default(uuid())
  tenantId    String
  fieldId     String
  role        UserRole
  /// Where this column sits for this role. Null keeps the base position.
  columnOrder Int?
  /// Off in this role's default view. Null keeps the base setting.
  hidden      Boolean?

  tenant Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  field  DatasetField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([fieldId, role])
  @@index([tenantId, role])
  @@map("dataset_field_roles")
}

/// CDM list `User`: the company's people directory.
///
/// Deliberately NOT related to `User`. That table is who can log into this app;
/// this one is every person the company employs, and the two overlap only
/// partly. `email1` is not unique here either — two pairs of people share a
/// shared mailbox in the source data — so it cannot be a key.
///
/// Column names mirror the sheet's header exactly, typos included (`phuneNumber`,
/// `not`, `possitionTier`). Renaming them here would break the mapping the
/// operators already read; the display names in `DatasetField` fix the spelling
/// where it is seen.
model CdmUser {
  id                    String    @id @default(uuid())
  tenantId              String

  /// The natural key — unique across all 122 source rows.
  internalId            String
  firstName             String?
  lastName              String?
  position              String?
  area                  String?
  dataAccess            Int?
  department            String?
  possitionTier         String?
  /// The company's own idea of a role (Management / Staff / Designer).
  /// NOT the app's UserRole enum, despite the name.
  role                  String?
  email1                String?
  email2                String?
  passwordEmail1        String?
  passwordEmail2Avantio String?
  phuneNumber           String?
  validity              String?
  cleaningArea          String?
  checkinCollaborator   Boolean?
  rajon                 String?
  nickname              String?
  not                   String?
  address               String?
  birthNumber           String?
  birthPlace            String?
  businessId            String?
  healthInsurer         String?
  tariff                String?
  terminationDate       DateTime?
  startDate             DateTime?
  folder                String?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, internalId])
  @@index([tenantId, lastName])
  @@map("cdm_users")
}

/// CDM list `Accomodation`: every unit the company operates.
///
/// 164 columns, names mirroring the sheet header exactly, typos included
/// (`cotractType`, `urlFolderphotos` beside `urlFolderPhotos`). Renaming them
/// here would break the vocabulary operators already read; `displayName` in
/// `dataset_fields` fixes the spelling where it is seen.
///
/// The primary key is `rowId`, not `id`, because the sheet has its own column
/// called `id` — the three-character internal code — which would otherwise
/// collide with Prisma's. `idAvantio` is the natural key: it is what the rest
