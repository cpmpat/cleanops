# Production credentials for the maintenance scripts (scripts/prod.sh).
#
# Copy to .env.production and fill in. That file is gitignored; this one is
# the committed template, so never put a real credential here.
#
# Neon: Console -> your project -> Connection Details -> pooled connection
# string. Must match what the Railway backend service uses.
DATABASE_URL='postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require'

# Needed only by `import:cdm`, which reads the CDM spreadsheet directly rather
# than via an exported file — that is what keeps the mailbox passwords in the
# list off anybody's disk. Copy the same one-line JSON the Railway backend
# service uses (Railway -> backend -> Variables -> GCP_SERVICE_ACCOUNT_JSON).
#
# MUST be wrapped in SINGLE quotes. prod.sh `source`s this file, so the shell
# reads the value: unquoted, it strips the JSON's own double quotes and splits
# on spaces, and what arrives is not JSON any more. Single quotes pass it
# through untouched. Keep it on one line — the private_key's newlines are
# already escaped as \n and must stay that way.
GCP_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"...@....iam.gserviceaccount.com"}'
